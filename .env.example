# Copiar en Vercel → Settings → Environment Variables

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Dirección pública de la app (va impresa en cada QR: no cambiarla después de imprimir etiquetas)
APP_URL=https://equipos.nybmedical.com

# Solo para desarrollo local sin Supabase (no se usa en producción)
# DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
